#!/bin/bash

# Install rosetta
echo 'Install rosetta and xcode tools'
/usr/sbin/softwareupdate --install-rosetta --agree-to-license
xcode-select --install

# Hide "last login" line when starting a new terminal session
touch $HOME/.hushlogin

# Install zsh
echo 'Install oh-my-zsh'
echo '-----------------'
rm -rf $HOME/.oh-my-zsh
curl -L https://raw.githubusercontent.com/robbyrussell/oh-my-zsh/master/tools/install.sh | sh

# Symlink git config and global gitignore
rm -f $HOME/.global-gitignore $HOME/.gitconfig
ln -s $HOME/.dotfiles/shell/.global-gitignore $HOME/.global-gitignore
ln -s $HOME/.dotfiles/shell/.gitconfig $HOME/.gitconfig

# Symlink zsh prefs
rm $HOME/.zshrc
ln -s $HOME/.dotfiles/shell/.zshrc $HOME/.zshrc

# Symlink vim prefs
rm $HOME/.vimrc
ln -s $HOME/.dotfiles/shell/.vimrc $HOME/.vimrc
rm $HOME/.vim
ln -s $HOME/.dotfiles/shell/.vim $HOME/.vim

# Symlink the Mackup config
ln -s $HOME/.dotfiles/macos/.mackup.cfg $HOME/.mackup.cfg

# Activate z
cd ~/.dotfiles/shell
chmod +x z.sh

sudo mkdir -p /usr/local/bin
sudo chown "${DEFAULT_USER}:admin" /usr/local/bin

echo 'Install homebrew'
echo '----------------'
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"
echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >>$HOME/.zprofile
eval "$(/opt/homebrew/bin/brew shellenv)"

echo 'Install NVM'
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                   # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion

echo 'Install node'
echo '------------'
nvm install --lts
nvm use --lts

echo 'Install Brewfile (formulae, casks, Mac App Store, npm)'
echo '-------------------------------------------------------'
# mas braucht eine Anmeldung im App Store, sonst schlagen die mas-Einträge fehl
brew bundle --file=$HOME/.dotfiles/Brewfile

echo 'Install Python tools (uv)'
echo '-------------------------'
uv tool install ptpython

export PATH="/opt/homebrew/opt/php/bin:$PATH"
export PATH="/opt/homebrew/opt/php/sbin:$PATH"

echo 'Install composer'
echo '----------------'
EXPECTED_COMPOSER_CHECKSUM="$(curl https://composer.github.io/installer.sig)"
php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');"
ACTUAL_COMPOSER_CHECKSUM="$(php -r "echo hash_file('sha384', 'composer-setup.php');")"
if [ "$EXPECTED_COMPOSER_CHECKSUM" != "$ACTUAL_COMPOSER_CHECKSUM" ]; then
    echo >&2 'ERROR: Invalid installer checksum'
    rm composer-setup.php
    exit 1
fi
php composer-setup.php
rm composer-setup.php
sudo mv composer.phar /usr/local/bin/composer

echo 'Install imagick, xdebug (pecl)'
echo '------------------------------'
pecl install imagick
pecl install xdebug

echo 'Set right composer path'
export PATH="$HOME/.composer/vendor/bin:$PATH"

echo 'Install laravel envoy'
echo '---------------------'
composer global require "laravel/envoy"

# PHP-Limits für die aktuell installierte PHP-Version
PHP_VERSION="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')"
mkdir -p /opt/homebrew/etc/php/$PHP_VERSION/conf.d
ln -sfn $HOME/.dotfiles/misc/php-limits.ini /opt/homebrew/etc/php/$PHP_VERSION/conf.d/php-z-custom-limits.ini

echo 'Install Google Fonts'
echo '--------------'
cd ~/Library/Fonts/ && rm -rf google-fonts && git clone https://github.com/google/fonts.git google-fonts && cd -

echo 'Install herdr + herdr-radar (iTerm font)'
echo '---------------------------------------'
chmod +x "$HOME/.dotfiles/scripts/setup-herdr.sh"
"$HOME/.dotfiles/scripts/setup-herdr.sh"

echo 'Configure PHPCS'
echo '--------------'
phpcs --config-set installed_paths ~/.dotfiles/phpcs

echo '++++++++++++++++++++++++++++++'
echo '++++++++++++++++++++++++++++++'
echo 'All done!'
echo '++++++++++++++++++++++++++++++'
echo 'Some optional tidbits'

echo '1. Make sure dropbox is running first. If you have not backed up via Mackup yet, then run `mackup backup` to symlink preferences for a wide collection of apps to your dropbox. If you already had a backup via mackup run `mackup restore` You'\''ll find more info on Mackup here: https://github.com/lra/mackup.'
echo '2. Set some sensible os x defaults by running: $HOME/.dotfiles/macos/set-defaults.sh'
echo '3. Make a .dotfiles-custom/shell/.aliases for your personal commands'
echo '4. Office 365, Cloudya, TermHere and Sonos can not be installed automatically. Please do to manually if you want to.'

echo '++++++++++++++++++++++++++++++'
echo '++++++++++++++++++++++++++++++'
